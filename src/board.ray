//! `rayserial fake-board`: a pseudo-terminal that behaves like a board on
//! the other end of a USB cable, so everything can be tested without one.
//!
//! Modes:
//! - sketch (default): an Arduino-like sketch — banner at boot and after a
//!   DTR reset, echoes what it gets, answers `led on|off`, `led?`, `ping`,
//!   `baud?`, `dump N`, `help`, and prints a sensor line every --sensor-ms.
//! - echo: every octet goes straight back (byte-exactness, round trips).
//! - sink: reads and counts (optionally at --rate octets/s, a slow peer);
//!   prints `RX <n> bytes sha256 <hex>` at the end.
//! - source: after the first octet it receives, writes --bytes octets of a
//!   fixed pseudo-random stream; prints `TX <n> bytes sha256 <hex>`.
//!
//! A DTR reset is seen through the shared termios: the client drops DTR
//! with an output speed of 0 (B0) — the only modem signal a pty carries.

import pty;
import sys;
import std/crypto;
import std/fs;
import std/hex;
import std/io;
import std/time;

pub struct BoardOptions {
    mode: string,
    for_ms: int,
    sensor_ms: int,
    rate: int,
    total: int,
    exit_idle_ms: int,
    link: string,
}

pub const BANNER: string = "\r\nrayserial fake board 1.0 (Arduino-like sketch)\r\ntype 'help' for commands\r\nready\r\n";

/// State of the sketch.
pub struct Sketch {
    led: bool,
    line: [int],
    readings: int,
    boots: int,
}

pub fn new_sketch() -> Sketch {
    Sketch { led: false, line: [], readings: 0, boots: 1 }
}

/// The sketch's answer to one command line (without the line ending).
pub fn answer(s: Sketch, line: string, baud: int) -> bytes {
    let cmd = line.trim().to_lower();
    if (cmd == "") {
        return b"";
    }
    if (cmd == "led on") {
        s.led = true;
        return b"LED ON\r\n";
    }
    if (cmd == "led off") {
        s.led = false;
        return b"LED OFF\r\n";
    }
    if (cmd == "led?" || cmd == "led") {
        return "LED is ${if (s.led) { "ON" } else { "OFF" }}\r\n".to_bytes();
    }
    if (cmd == "ping") {
        return b"pong\r\n";
    }
    if (cmd == "baud?" || cmd == "baud") {
        return "baud ${baud}\r\n".to_bytes();
    }
    if (cmd == "boots?") {
        return "boots ${s.boots}\r\n".to_bytes();
    }
    if (cmd == "help") {
        return b"commands: led on, led off, led?, ping, baud?, boots?, dump N, help\r\n";
    }
    if (cmd.starts_with("dump ")) {
        let n = parse_int(cmd.substring(5, cmd.len()).trim()).unwrap_or(-1);
        if (n < 0 || n > 1048576) {
            return b"ERR dump needs 0..1048576\r\n";
        }
        var body: [int] = [];
        for i in 0..n {
            body.push(i % 256);
        }
        let head = "BEGIN ${n}\r\n";
        return head.to_bytes() + bytes_of(body) + b"\r\nEND\r\n";
    }
    "ERR unknown command: ${line.trim()}\r\n".to_bytes()
}

/// Feeds received octets to the sketch: the echo (CR → CR LF) plus the
/// answers of every completed line.
pub fn sketch_feed(s: Sketch, chunk: bytes, baud: int) -> bytes {
    var out: [bytes] = [];
    var echo: [int] = [];
    for b in chunk {
        if (b == 0x0D || b == 0x0A) {
            if (b == 0x0D) {
                echo.push(0x0D);
                echo.push(0x0A);
            }
            if (b == 0x0D || s.line.len() > 0) {
                out.push(bytes_of(echo));
                echo = [];
                let text = from_utf8(bytes_of(s.line)).unwrap_or("?");
                s.line = [];
                out.push(answer(s, text, baud));
            }
        } else if (b == 0x08 || b == 0x7F) {
            if (s.line.len() > 0) {
                let _ = s.line.pop();
                echo.push(0x08);
                echo.push(0x20);
                echo.push(0x08);
            }
        } else {
            echo.push(b);
            if (s.line.len() < 256) {
                s.line.push(b);
            }
        }
    }
    out.push(bytes_of(echo));
    bytes_concat(out)
}

/// The n-th sensor line (deterministic, so tests can expect it).
pub fn sensor_line(n: int) -> string {
    "sensor n=${n} temp=${20 + n % 10}.${n % 7} hum=${40 + n % 13}\r\n"
}

/// 64 KiB of a fixed LCG stream: the source mode repeats it.
pub fn pattern_block() -> bytes {
    var out: [int] = [];
    var x = 12345;
    for _ in 0..65536 {
        x = (x * 1103515245 + 12345) % 2147483648;
        out.push((x >> 16) & 255);
    }
    bytes_of(out)
}

/// Writes without blocking forever: if the client is not reading, the
/// board waits up to `stall_ms` and then drops (like a full USB FIFO).
fn emit(m: int, b: bytes, stall_ms: int) -> bool {
    if (b.len() == 0) {
        return true;
    }
    sys.write_all(m, b, stall_ms).is_ok()
}

fn hash_hex(h: int) -> string {
    match (crypto.hash_final(h)) {
        Result.Ok(d) => hex.hex_encode(d),
        Result.Err(e) => "error: ${e}",
    }
}

/// Runs the board until --for, --exit-idle, SIGINT/SIGTERM.
pub fn run(o: BoardOptions) -> Result<int, string> {
    let pair = pty.open_pair()?;
    let held = pty.hold_slave(pair)?;
    if (o.link != "") {
        let _ = fs.remove_file(o.link);
        fs.symlink(pair.slave_path, o.link)?;
    }
    print("PORT ${pair.slave_path}");
    let _ = io.flush();
    let m = pair.master;
    let sig = signals();
    let start = time.monotonic_millis();
    let sketch = new_sketch();
    var in_reset = false;
    var next_sensor = start + o.sensor_ms;
    var count = 0;
    var last_rx = start;
    var hasher = crypto.sha256_init()?;
    var source_sent = 0;
    var source_on = false;
    let block = if (o.mode == "source") { pattern_block() } else { b"" };
    var budget_at = start;
    var budget = 0;
    if (o.mode == "sketch") {
        emit(m, BANNER.to_bytes(), 200);
    }
    while (true) {
        let now = time.monotonic_millis();
        if (o.for_ms > 0 && now - start >= o.for_ms) {
            break;
        }
        if (o.exit_idle_ms > 0 && count > 0 && now - last_rx >= o.exit_idle_ms && !source_on) {
            break;
        }
        match (try_recv(sig)) {
            Received.Got(s) => if (s == 2 || s == 15) {
                break;
            },
            _ => { },
        }
        // DTR reset detection: the shared termios shows ospeed 0 while the
        // client holds DTR low.
        let speed = match (pty.peer_config(m)) {
            Result.Ok(c) => c.baud,
            Result.Err(_) => -1,
        };
        if (speed == 0 && !in_reset) {
            in_reset = true;
        } else if (speed > 0 && in_reset) {
            in_reset = false;
            if (o.mode == "sketch") {
                sketch.led = false;
                sketch.line = [];
                sketch.boots = sketch.boots + 1;
                next_sensor = time.monotonic_millis() + o.sensor_ms;
                emit(m, BANNER.to_bytes(), 200);
            }
        }
        if (o.mode == "source" && source_on && source_sent < o.total) {
            let n = if (o.total - source_sent < block.len()) {
                o.total - source_sent
            } else {
                block.len()
            };
            let piece = if (n == block.len()) { block } else { block.sub_bytes(0, n) };
            match (sys.write_all(m, piece, 10000)) {
                Result.Ok(_) => {
                    crypto.hash_update(hasher, piece)?;
                    source_sent = source_sent + n;
                    if (source_sent >= o.total) {
                        print("TX ${source_sent} bytes sha256 ${hash_hex(hasher)}");
                        let _ = io.flush();
                        hasher = crypto.sha256_init()?;
                        source_on = false;
                        last_rx = time.monotonic_millis();
                    }
                },
                Result.Err(e) => return Result.Err("source: ${e}"),
            }
            continue;
        }
        if (o.mode == "sketch" && o.sensor_ms > 0 && now >= next_sensor && !in_reset) {
            sketch.readings = sketch.readings + 1;
            emit(m, sensor_line(sketch.readings).to_bytes(), 0);
            next_sensor = now + o.sensor_ms;
        }
        // Rate limit (sink): refill the budget every 10 ms.
        var want = 65536;
        if (o.rate > 0) {
            let t = time.monotonic_millis();
            if (t - budget_at >= 10) {
                budget = o.rate * (t - budget_at) / 1000;
                if (budget > o.rate) {
                    budget = o.rate;
                }
                budget_at = t;
            }
            if (budget <= 0) {
                time.sleep(5);
                continue;
            }
            want = if (budget < 65536) { budget } else { 65536 };
        }
        let ready = sys.poll_fds([m], [sys.POLLIN], 20)?;
        if (ready.len() == 0 || (ready[0] & sys.POLLIN) == 0) {
            // On the VM a signal reaches signals() only while the fiber parks:
            // an FFI poll does not park it, a real sleep does (1 ms when idle).
            time.sleep(1);
            continue;
        }
        match (sys.read_chunk(m, want)) {
            sys.Chunk.Data(b) => {
                count = count + b.len();
                last_rx = time.monotonic_millis();
                if (o.rate > 0) {
                    budget = budget - b.len();
                }
                if (o.mode == "echo") {
                    if (!emit(m, b, 10000)) {
                        return Result.Err("echo: the client stopped reading");
                    }
                } else if (o.mode == "sink") {
                    crypto.hash_update(hasher, b)?;
                } else if (o.mode == "source") {
                    if (!source_on) {
                        source_on = true;
                        source_sent = 0;
                    }
                } else {
                    // read the speed again: the client may have changed it while we
                    // were waiting in poll
                    let now_speed = match (pty.peer_config(m)) {
                        Result.Ok(c) => c.baud,
                        Result.Err(_) => speed,
                    };
                    let reply = sketch_feed(sketch, b, now_speed);
                    emit(m, reply, 2000);
                }
            },
            sys.Chunk.Again => { },
            sys.Chunk.Eof => time.sleep(20),
            sys.Chunk.Failed(code, msg) => {
                if (code != sys.EIO) {
                    return Result.Err(msg);
                }
                time.sleep(20);
            },
        }
    }
    if (o.mode == "sink") {
        print("RX ${count} bytes sha256 ${hash_hex(hasher)}");
    }
    if (o.mode != "sink" && o.mode != "source") {
        print("RX ${count} bytes");
    }
    let _ = io.flush();
    sys.close_fd(held);
    sys.close_fd(m);
    if (o.link != "") {
        let _ = fs.remove_file(o.link);
    }
    Result.Ok(count)
}
